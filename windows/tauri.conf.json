{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lernpass",
  "version": "1.7.2",
  "identifier": "at.lernpass.mec.windows",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Lernpass",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "decorations": false,
        "resizable": true,
        "maximizable": true,
        "transparent": true,
        "windowEffects": {
          "effects": [
            "mica"
          ],
          "state": "active"
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Dein Mechatronik-Lernpass für MEC H1",
    "category": "Education",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "German"
        ],
        "displayLanguageSelector": false,
        "startMenuFolder": "Lernpass"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkxMDlCRkRCMzI5RjdCNkYKUldSdmU1OHkyNzhKa1JSUlNkbWlnSlVGRmRpaUh5QmZkRmNPeXhvSXorQlUzaENpcEpTZ3IzUTUK",
      "endpoints": [
        "https://github.com/Jogurella/Lernpass/releases/latest/download/latest.json"
      ]
    }
  }
}
