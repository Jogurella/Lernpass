{
  "appId": "at.lernpass.mec",
  "appName": "Lernpass",
  "webDir": "app",
  "ios": {
    "contentInset": "never",
    "allowsLinkPreview": false,
    "scrollEnabled": true,
    "preferredContentMode": "mobile",
    "path": "ios/native"
  },
  "plugins": {
    "Keyboard": {
      "resize": "native"
    },
    "SplashScreen": {
      "launchAutoHide": true
    },
    "StatusBar": {
      "overlaysWebView": true
    }
  }
}
